{
    "name": "jackwander/laravel-module-maker",
    "version": "2.8.0",
    "description": "Zero-config modular (Domain-Driven) architecture generator for Laravel 11, 12 and 13.",
    "keywords": ["laravel", "modules", "modular", "module-generator", "artisan", "scaffolding", "ddd", "generator", "mcp"],
    "homepage": "https://module-maker.jackwander.pro/",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Jerwin",
            "email": "me@jackwander.pro"
        }
    ],
    "support": {
        "issues": "https://github.com/jackwander/Laravel-Module-Maker/issues",
        "source": "https://github.com/jackwander/Laravel-Module-Maker"
    },
    "require": {
        "php": "^8.2",
        "illuminate/support": "^11.0 || ^12.0 || ^13.0",
        "illuminate/console": "^11.0 || ^12.0 || ^13.0",
        "illuminate/filesystem": "^11.0 || ^12.0 || ^13.0"
    },
    "require-dev": {
        "orchestra/testbench": "^9.0 || ^10.0 || ^11.0",
        "pestphp/pest": "^3.0 || ^4.0",
        "pestphp/pest-plugin-laravel": "^3.0 || ^4.0"
    },
    "autoload": {
        "psr-4": {
            "Jackwander\\ModuleMaker\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Jackwander\\ModuleMaker\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Jackwander\\ModuleMaker\\ModuleServiceProvider"
            ]
        }
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}